# 복사해서 .env 로 저장하고 값을 채운다. .env 는 절대 커밋하지 않는다 (CHARTER.md §8.4).
# 실수로 올렸으면 즉시 토큰 폐기·재발급 후 히스토리 정리.

# GitHub 개인 접근 토큰 (classic, public_repo 권한만). PR·이슈 수집에 필수 (§7).
# 발급: GitHub → Settings → Developer settings → Personal access tokens (classic)
GITHUB_TOKEN=

# LLM API 키 (기준선 B·후보 생성용, ADR-005). 필요한 것만 채운다.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# PostgreSQL 16 + pgvector (docker-compose.yml 이 이 값을 읽는다)
POSTGRES_USER=dcs
POSTGRES_PASSWORD=dcs
POSTGRES_DB=deleted_code_search
POSTGRES_PORT=5432
DATABASE_URL=postgresql://dcs:dcs@localhost:5432/deleted_code_search

# 로컬 작업 디렉터리 (클론 저장소·추출 결과, .gitignore 대상)
REPOS_DIR=./repos
DATA_DIR=./data
